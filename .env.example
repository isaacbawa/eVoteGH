# ── Neon (PostgreSQL) ────────────────────────────────────────────────────
# Get this from your Neon project dashboard → Connection Details
# Use the "pooled connection" string for serverless/edge friendliness.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/evotegh?sslmode=require"

# ── Clerk (Auth) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
# Used to verify Clerk webhook signatures (Svix) for /api/webhooks/clerk
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxx"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ── Cloudinary (file/photo uploads — replaces Base44 UploadFile) ──────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="xxxxxxxxxxxxxxxxxxx"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxx"

# ── Resend (email — replaces Base44 SendEmail) ─────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="eVoteGH <notifications@yourdomain.com>"

# ── Paystack (payments) ────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"

# ── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
